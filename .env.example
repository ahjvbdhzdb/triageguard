# TriageGuard — Environment Variables
# Copy this to .env and fill in values. Do NOT commit .env itself.

# Backend API URL — where the Qwen triage endpoint lives.
# In dev, Vite proxies /functions/v1/app to this address.
# Leave blank to use the built-in demo triage engine (keyword matching, no real AI).
VITE_API_URL=http://127.0.0.1:8000
